+@OptIn(androidx.compose.foundation.layout.ExperimentalLayoutApi::class)
+@Composable
+private fun MiniPlayerHudStylePicker() {
+    val (style, onStyleChange) = rememberEnumPreference(
+        MiniPlayerBackgroundStyleKey,
+        MiniPlayerBackgroundStyle.GRADIENT,
+    )
+    val options = listOf(
+        MiniPlayerBackgroundStyle.DEFAULT to "Default",
+        MiniPlayerBackgroundStyle.TRANSPARENT to "Transparent",
+        MiniPlayerBackgroundStyle.BLUR to "Blur",
+        MiniPlayerBackgroundStyle.GLASS to "Glass / Kaca",
+        MiniPlayerBackgroundStyle.GRADIENT to "Gradient",
+        MiniPlayerBackgroundStyle.PURE_BLACK to "Pure Black",
+    )
+    Column(Modifier.fillMaxWidth().padding(horizontal = 16.dp)) {
+        Text(
+            text = "HUD Mini Player",
+            style = MaterialTheme.typography.titleMedium,
+            fontWeight = FontWeight.Bold,
+        )
+        Text(
+            text = "Atur bentuk, efek kaca/blur, dan tampilan tombol mini player ala iOS.",
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+        Spacer(Modifier.height(10.dp))
+        FlowRow(
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            options.forEach { (value, label) ->
+                androidx.compose.material3.FilterChip(
+                    selected = style == value,
+                    onClick = { onStyleChange(value) },
+                    label = { Text(label) },
+                    leadingIcon = if (style == value) {
+                        { Icon(painterResource(R.drawable.check), contentDescription = null, modifier = Modifier.size(16.dp)) }
+                    } else null,
+                )
+            }
+        }
+    }
+}
